# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Distribution / packaging
*.egg-info/
dist/
build/
*.egg
*.whl
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Editor / OS artefacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Generated audio files (do not commit)
*.wav
*.ogg
*.mp3

# Local model caches/weights (keep models/ scaffold files only)
models/*/

# Keep user sample libraries out of git (folder scaffold remains tracked)
samples/orchestral/**/*.wav
samples/orchestral/**/*.WAV
samples/orchestral/**/*.aif
samples/orchestral/**/*.aiff
samples/sfx/**/*.wav
samples/sfx/**/*.WAV
samples/voice/**/*.wav
samples/voice/**/*.WAV
